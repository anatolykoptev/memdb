# MemDB — Go stack self-hosting configuration
# Copy to .env and fill in the required values before running docker compose.
#
# Required fields are marked [required].
# Optional fields can be left at their defaults for a minimal local deployment.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=memdb
POSTGRES_PASSWORD=change-me-to-something-strong   # [required] change before deploy
POSTGRES_DB=memdb

# Connection URL used by memdb-go (references the vars above)
MEMDB_POSTGRES_URL=postgresql://memdb:change-me-to-something-strong@postgres:5432/memdb

# ── LLM provider ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible base URL works: OpenAI, OpenRouter, LiteLLM, Ollama, etc.
# See docs/llm-providers.md for alternatives.
MEMDB_LLM_PROXY_URL=https://api.openai.com/v1
MEMDB_LLM_API_KEY=sk-...   # [required] your API key
MEMDB_LLM_MODEL=gpt-4o-mini

# ── Embeddings ───────────────────────────────────────────────────────────────
# Set MEMDB_EMBEDDER_TYPE=http and point at an embed-server sidecar for
# local GPU/CPU embeddings (see docs/embed-server.md).
# Alternatively use MEMDB_EMBEDDER_TYPE=ollama or voyage (VoyageAI).
MEMDB_EMBEDDER_TYPE=http
MEMDB_EMBED_URL=http://embed-server:8080   # active when embed-server profile is enabled

# ── Logging ──────────────────────────────────────────────────────────────────
MEMDB_LOG_LEVEL=info    # debug | info | warn | error
MEMDB_LOG_FORMAT=json   # json | text

# ── D10 Answer Extractor ─────────────────────────────────────────────────────
# D10 distils the top retrieved memories into one short, query-aligned answer
# via a single LLM call (see memdb-go/internal/search/answer_enhance.go).
#
# The 5+ env knobs that grew organically are now consolidated into
# (1) a master on/off flag, (2) a hardness preset bundle, (3) a prompt-mode
# selector, and (4) per-knob overrides for power users.
MEMDB_SEARCH_ENHANCE=true                    # Master on/off (default: false)
MEMDB_D10_HARDNESS=balanced                  # tight | balanced | loose
MEMDB_D10_PROMPT_MODE=probabilistic          # strict | soft | probabilistic
#
# Hardness preset bundles (applied first; per-knob envs override):
#   tight    — confidence=0.50, classifier=0.70, min_relativity=0.50
#              "answer only when retrieval is overwhelmingly confident"
#   balanced — confidence=0.30, classifier=0.50, min_relativity=0.40 (default)
#   loose    — confidence=0.20, classifier=0.40, min_relativity=0.30
#              "answer aggressively, more synthesis, more hallucination risk"
#
# Prompt modes:
#   strict        — pre-#249 verbatim. "Use the exact surface form".
#                   Best on extraction benchmarks (LLM-Judge 0.35 in claude_NS).
#   soft          — PR #249 prompt. Allows synthesis from atomic-fact rows.
#                   Reduced UNKNOWN rate but tends to over-paraphrase.
#   probabilistic — PR #252 default. Single base prompt + classifier-driven
#                   hint append (gated by classifier confidence and category).
#                   Strict and soft modes do NOT call the classifier (zero
#                   embed cost on A/B sweeps); probabilistic does.
#
# Per-knob overrides — uncomment to override a single field of the hardness
# preset; everything else stays bundle-consistent.
# MEMDB_FACTUAL_CONFIDENCE_THRESHOLD=0.30      # gate for high vs low factual prompt
# MEMDB_FACTUAL_CONFIDENCE_FORMULA=multifeature  # top1 | multifeature
# MEMDB_FACTUAL_CONFIDENCE_WEIGHTS=top1=0.55,spread=0.20,density=0.15,median=0.10
# MEMDB_FACTUAL_DENSITY_FLOOR=0.30
# MEMDB_D10_CLASSIFIER_THRESHOLD=0.50          # min top-1 conf for hint append
# MEMDB_D10_CLASSIFIER_ENABLED=true            # disable to bypass classifier
# MEMDB_D10_MIN_RELATIVITY=0.40                # candidate floor for D10 input
